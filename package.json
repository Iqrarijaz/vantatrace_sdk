{
  "name": "@vantatrace/sdk",
  "version": "0.3.0",
  "description": "Drop-in observability SDK for Node.js microservices powering error tracking, structured logging, and real-time telemetry pipelines.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "babel-plugin.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.mjs",
      "require": "./dist/runtime.js"
    },
    "./babel-plugin": "./babel-plugin.js"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup && node scripts/verify-dual-build.mjs",
    "test": "tsx --test src/registry.test.ts src/runtime.test.ts src/caught-exceptions.test.ts src/index.test.ts src/masking.test.ts src/winston.test.ts src/rateLimiter.test.ts src/instrumentation.test.ts src/transport.test.ts src/tracecontext.test.ts src/consoleInstrumentation.test.ts src/httpInstrumentation.test.ts src/pino.test.ts src/autoCaptureFinisher.test.ts src/requestContext.test.ts babel-plugin.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "observability",
    "error-tracking",
    "logging",
    "telemetry",
    "nodejs",
    "microservices",
    "monitoring",
    "crash-reporting",
    "exception-handling",
    "debugging",
    "apm",
    "distributed-systems",
    "vantatrace"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iqrarijaz/vantatrace_sdk.git"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^20.11.0",
    "pino": "^10.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5.3.3",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0"
  },
  "dependencies": {
    "@babel/helper-module-imports": "^7.29.7"
  },
  "peerDependencies": {
    "@babel/core": "^7.24.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    }
  }
}
